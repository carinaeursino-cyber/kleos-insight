# KLEOS INSIGHT™ Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Gemini API (Required for real analysis)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: For Vertex AI instead of Google AI Studio
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# VERTEX_AI_PROJECT_ID=your-project-id
# VERTEX_AI_LOCATION=us-central1

# Database (if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/kleos_insight
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/kleos

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/combined.log

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this
CORS_ORIGIN=http://localhost:3000,http://localhost:8000

# Email (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Analytics (optional)
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# GA_TRACKING_ID=G-XXXXXXXXXX

# Feature Flags
ENABLE_MOCK_DATA=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ANALYTICS=false
